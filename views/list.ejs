<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/favicon.ico" type="image/x-icon">
    <title>Ferramentas Gratuitas para Produtividade | infoDevBrasil</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }
        header {
            background-color: #0a0a0a;
            border-bottom: 3px solid #1bf668;
            color: #fff;
            padding: 1.5rem 0;
            text-align: center;
        }
        header img { width: 70px; margin-bottom: 8px; }
        header h1 { margin: 0; font-size: 1.8rem; }
        .container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }
        .category { margin-bottom: 1rem; }
        .category h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: #17d95c;
        }
        .tool {
            display: flex;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            background: #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            transition: box-shadow 0.3s ease;
        }
        .tool:hover {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .tool a {
            text-decoration: none;
            color: #0a7a3c;
            font-weight: 700;
            font-size: 1.1rem;
        }
        footer {
            text-align: center;
            background-color: #0a0a0a;
            color: #fff;
            padding: 1rem 0;
            margin-top: 2rem;
        }
        .back-link { display: inline-block; margin: 1rem 0 0 1rem; color: #17d95c; font-weight: 600; text-decoration: none; }
    </style>
</head>
<body>
    <header>
        <img src="/assets/logo.png" alt="infoDevBrasil">
        <h1>Melhores Ferramentas Gratuitas para Produtividade</h1>
    </header>
    <a href="/" class="back-link">&larr; Voltar ao Dashboard</a>
    <div class="container">
        <div class="category">
            <h2>Gerenciamento de Tarefas e Projetos</h2>
            <div class="tool"><a href="https://trello.com" target="_blank" rel="noopener noreferrer">Trello</a></div>
            <div class="tool"><a href="https://notion.so" target="_blank" rel="noopener noreferrer">Notion</a></div>
            <div class="tool"><a href="https://asana.com" target="_blank" rel="noopener noreferrer">Asana</a></div>
        </div>

        <div class="category">
            <h2>Comunicação e Colaboração</h2>
            <div class="tool"><a href="https://slack.com" target="_blank" rel="noopener noreferrer">Slack</a></div>
            <div class="tool"><a href="https://zoom.us" target="_blank" rel="noopener noreferrer">Zoom</a></div>
            <div class="tool"><a href="https://www.microsoft.com/microsoft-teams" target="_blank" rel="noopener noreferrer">Microsoft Teams</a></div>
        </div>

        <div class="category">
            <h2>Notas e Ideias</h2>
            <div class="tool"><a href="https://keep.google.com" target="_blank" rel="noopener noreferrer">Google Keep</a></div>
            <div class="tool"><a href="https://evernote.com" target="_blank" rel="noopener noreferrer">Evernote</a></div>
        </div>

        <div class="category">
            <h2>Armazenamento em Nuvem</h2>
            <div class="tool"><a href="https://drive.google.com" target="_blank" rel="noopener noreferrer">Google Drive</a></div>
            <div class="tool"><a href="https://www.dropbox.com" target="_blank" rel="noopener noreferrer">Dropbox</a></div>
        </div>

        <div class="category">
            <h2>Automação</h2>
            <div class="tool"><a href="https://zapier.com" target="_blank" rel="noopener noreferrer">Zapier</a></div>
            <div class="tool"><a href="https://ifttt.com" target="_blank" rel="noopener noreferrer">IFTTT</a></div>
        </div>

        <div class="category">
            <h2>Tempo e Foco</h2>
            <div class="tool"><a href="https://clockify.me" target="_blank" rel="noopener noreferrer">Clockify</a></div>
            <div class="tool"><a href="https://toggl.com/track/" target="_blank" rel="noopener noreferrer">Toggl Track</a></div>
            <div class="tool"><a href="https://www.forestapp.cc" target="_blank" rel="noopener noreferrer">Forest</a></div>
        </div>

        <div class="category">
            <h2>Edição de Documentos e Planilhas</h2>
            <div class="tool"><a href="https://workspace.google.com/" target="_blank" rel="noopener noreferrer">Google Workspace</a></div>
            <div class="tool"><a href="https://www.libreoffice.org/" target="_blank" rel="noopener noreferrer">LibreOffice</a></div>
        </div>

        <div class="category">
            <h2>Gestão de Senhas</h2>
            <div class="tool"><a href="https://bitwarden.com" target="_blank" rel="noopener noreferrer">Bitwarden</a></div>
        </div>

        <div class="category">
            <h2>Design e Criatividade</h2>
            <div class="tool"><a href="https://www.canva.com" target="_blank" rel="noopener noreferrer">Canva</a></div>
            <div class="tool"><a href="https://figma.com" target="_blank" rel="noopener noreferrer">Figma</a></div>
        </div>

        <div class="category">
            <h2>Aprendizado e Desenvolvimento</h2>
            <div class="tool"><a href="https://www.khanacademy.org" target="_blank" rel="noopener noreferrer">Khan Academy</a></div>
            <div class="tool"><a href="https://www.coursera.org" target="_blank" rel="noopener noreferrer">Coursera</a></div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 infoDevBrasil | Criado com ❤️</p>
    </footer>
</body>
</html>
