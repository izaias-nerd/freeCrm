<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/style.css">
    <title>Lista de Notas | infoDevBrasil CRM</title>
    <style>
        .notes-wrap { max-width: 600px; margin: 0 auto; text-align: center; }
        .notes-actions { margin: 20px 0; display: flex; gap: 10px; justify-content: center; }
        .notes-list { list-style: none; text-align: left; }
        .notes-list li {
            background-color: var(--card-bg);
            color: #222;
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow);
        }
        .empty-msg { color: var(--text-muted); }
    </style>
</head>
<body>
    <%- include('partials/sidebar') %>

    <div class="content">
        <div class="notes-wrap">
            <h1 class="page-title">Lista de Notas</h1>
            <div class="notes-actions">
                <a href="/notes" class="btn">Adicionar Nova Nota</a>
                <a href="/" class="btn" style="background:#333;color:#fff;">Voltar ao Dashboard</a>
            </div>

            <ul class="notes-list">
                <% if (notas.length > 0) { %>
                    <% notas.forEach(nota => { %>
                        <li>
                            <span><%= nota.nota %></span>
                            <form action="/delete-note/<%= nota.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn-danger">Excluir</button>
                            </form>
                        </li>
                    <% }); %>
                <% } else { %>
                    <p class="empty-msg">Nenhuma nota disponível.</p>
                <% } %>
            </ul>
        </div>
    </div>

    <script src="/js/sidebar.js"></script>
</body>
</html>
